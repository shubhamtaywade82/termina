		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"chalk": "^6.0.1",
		"delay": "^7.0.0",
		"eslint-config-xo-react": "^0.32.0",
		"react": "^19.3.1",
		"strip-ansi": "^7.2.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"xo": "^5.0.1"
	},
	"peerDependencies": {
		"react": ">=19.3.0"
	}
}
