    "@types/ws": "^8.18.2",
    "@vdemedes/prettier-config": "^2.0.1",
    "@xterm/headless": "^6.0.0",
    "boxen": "^9.0.0",
    "delay": "^7.0.0",
    "eslint-config-xo-react": "^0.32.0",
    "ms": "^2.1.3",
    "node-pty": "^1.2.0-beta.12",
    "p-queue": "^10.0.0",
    "prettier": "^3.9.9",
    "react": "^19.3.1",
    "react-devtools-core": "^8.0.0",
    "sinon": "^22.1.0",
    "slice-ansi": "^9.0.1",
