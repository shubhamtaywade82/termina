    "chalk": "^6.0.1",
    "cli-boxes": "^4.0.1",
    "cli-cursor": "^5.0.0",
    "cli-truncate": "^6.0.0",
    "code-excerpt": "^4.0.0",
    "es-toolkit": "^1.52.0",
    "indent-string": "^5.0.0",
    "is-in-ci": "^2.0.0",
    "patch-console": "^2.0.0",
