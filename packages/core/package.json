{
  "name": "@nemesis-oss/termina-core",
  "version": "0.2.0",
  "private": false,
  "description": "Fork of vadimdemedes/ink@8.0.0 (React reconciler + Yoga renderer for terminal UIs).",
  "keywords": [
    "react",
    "terminal",
    "tui",
    "cli",
    "ink",
    "yoga",
    "reconciler",
    "renderer"
  ],
  "author": "Shubham Taywade <shubhamtaywade82@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/shubhamtaywade82/termina/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/termina.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/termina/issues"
  },
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    "types": "./build/index.d.ts",
    "default": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p bench/tsconfig.json",
    "bench": "node --import=tsx bench/render-throughput.tsx",
    "lint": "xo",
    "test": "node ../../scripts/run-node-tests.mjs \"test/*.{ts,tsx}\" \"test/posix/*.tsx\"",
    "pretest": "tsc"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.1",
