    "wrap-ansi": "^10.0.2",
    "yoga-layout": "~3.2.1"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "@types/react": ">=19.3.0",
    "react-devtools-core": ">=6.1.2"
  },
