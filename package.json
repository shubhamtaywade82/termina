{
  "name": "termina-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
	"lint": "pnpm -r --filter './packages/*' run lint",
    "typecheck": "pnpm -r --filter './packages/*' --filter './examples/*' run typecheck",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "test": "pnpm run build && pnpm -r --no-bail --filter './packages/*' run test",
    "skills:check": "node .agents/scripts/validate-skills.mjs",
    "verify": "pnpm skills:check && pnpm evals:check && pnpm run build && pnpm run typecheck && pnpm run test",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:check": "node scripts/check-docs.mjs",
    "release:rehearse": "node scripts/rehearse-release.mjs",
    "docs:previews": "pnpm --filter termina-docs-previews run generate",
    "docs:previews:check": "pnpm --filter termina-docs-previews run check",
    "audit:ci": "pnpm audit --prod --audit-level=high",
    "ci": "pnpm install --frozen-lockfile && pnpm skills:check && pnpm evals:check && pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm docs:previews:check && pnpm docs:check && pnpm release:rehearse && pnpm audit:ci",
    "evals:check": "node .agents/scripts/validate-evals.mjs && node .agents/scripts/eval-prompt.mjs --check && node .agents/scripts/test-evals-tooling.mjs",
    "evals:prompt": "node .agents/scripts/eval-prompt.mjs",
    "evals:report:check": "node .agents/scripts/validate-eval-report.mjs"
  }
}
