{
  "name": "termina-docs-previews",
  "version": "0.1.0",
  "private": true,
  "description": "Renders the terminal previews embedded in the docs site. Writes docs-site/.vitepress/generated/previews.json.",
  "type": "module",
  "scripts": {
    "generate": "tsx src/generate.tsx",
    "check": "tsx src/generate.tsx --check",
    "typecheck": "tsc --noEmit",
    "print": "tsx src/print.tsx"
  },
  "dependencies": {
    "@nemesis-oss/termina-core": "workspace:*",
    "@nemesis-oss/termina-ui": "workspace:*",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
