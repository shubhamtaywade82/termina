{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["vite/client"]
  },
  "include": [
    ".vitepress/config.ts",
    ".vitepress/theme/**/*.ts",
    ".vitepress/theme/**/*.tsx",
    ".vitepress/theme/**/*.vue"
  ]
}
